+/* KPEER averaged-parent helpers.  The parent is frozen-like before z_c,
+   approaches w_post after activation, and transfers a finite fraction to
+   dark radiation through Q^mu = Gamma(a) rho_fld u_fld^mu. */
+static double kpeer_logistic(double x) {
+  if (x >= 0.) return 1./(1.+exp(-x));
+  return exp(x)/(1.+exp(x));
+}
+
+static double kpeer_softplus(double x) {
+  if (x > 40.) return x;
+  if (x < -40.) return exp(x);
+  return log1p(exp(x));
+}
+
+double kpeer_decay_gamma_over_h(struct background *pba, double a) {
+  double center, x, tau;
+  if ((((pba->fluid_equation_of_state != KPEER) || (pba->has_fld == _FALSE_))
+       && ((pba->kpeer_exact_scf == _FALSE_) || (pba->has_scf == _FALSE_)))
+      || (pba->kpeer_decay_fraction <= 0.)) return 0.;
+  center = -log1p(pba->kpeer_decay_z);
+  x = (log(a)-center)/pba->kpeer_decay_width;
+  tau = -log1p(-pba->kpeer_decay_fraction);
+  return tau/sqrt(2.*_PI_)/pba->kpeer_decay_width*exp(-0.5*x*x);
+}
