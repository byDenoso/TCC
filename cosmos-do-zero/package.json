{
  "name": "cosmos-do-zero",
  "version": "4.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "node scripts/astro-local.mjs dev",
    "build": "node scripts/astro-local.mjs build && node scripts/postbuild.mjs",
    "preview": "node scripts/astro-local.mjs preview",
    "check": "node scripts/astro-local.mjs check",
    "test": "vitest run",
    "test:http": "node tests/http.mjs",
    "test:e2e": "node tests/e2e.mjs",
    "serve": "node scripts/serve-dist.mjs",
    "test:browsers": "node tests/browser-smoke.mjs",
    "test:renders": "node tests/renders.mjs",
    "test:pages": "node tests/pages-base.mjs",
    "test:graphics": "node tests/graphics.mjs && node tests/autoplay-visible.mjs && node tests/dynamic-experience.mjs",
    "test:autoplay": "node tests/autoplay-visible.mjs",
    "test:motion": "node tests/motion-lab.mjs",
    "test:cinema": "node tests/story-cinema.mjs",
    "test:experience": "node tests/ambient-motion.mjs && node tests/beginner-flow.mjs && node tests/visual-fallback.mjs",
    "test:dynamic": "node tests/dynamic-experience.mjs"
  },
  "dependencies": {
    "@fontsource-variable/fraunces": "^5.3.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/inter-tight": "^5.3.0",
    "@types/three": "^0.170.0",
    "astro": "^7.3.8",
    "gsap": "3.13.0",
    "three": "^0.170.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "playwright": "^1.50.0",
    "rolldown": "~1.2.13",
    "sharp": "0.35.5",
    "typescript": "^5.6.0",
    "vitest": "4.1.11"
  }
}
