---
import { chapterUrl, u } from '../lib/url';
import { scaleLogs, scaleStations } from '../data/scale-stations';
import '../styles/scale-blackhole.css';
import '../styles/scale-journey.css';

const ticks = [-15, -5, 5, 15, 25];
const minLog = scaleLogs[0];
const logSpan = scaleLogs.at(-1)! - minLog;
const position = (log: number) => 100 * (log - minLog) / logSpan;
const number = (i: number) => String(i + 1).padStart(2, '0');
const detailed = new Set(['earth', 'solar-system', 'scale-hydrogen', 'scale-proton', 'scale-cell', 'group-local', 'cosmic-web', 'scale-horizon']);
function poster(name: string, width = 1200) {
  if (detailed.has(name)) return u(`/models/worlds-hd/scales/${name}-${width}.webp`);
  const suffix = width === 600 ? '-small' : '';
  if (name === 'galaxies') return u(`/renders/milky-way${suffix}.webp`);
  return u(`/posters/${name}${suffix}.webp`);
}
const candidates = (name: string) => (detailed.has(name) ? [600,1200,1800] : [600,1200])
  .map(width => `${poster(name,width)} ${width}w`).join(', ');
const plates: Record<string, { alt: string; caption: string; text?: string }> = {
  'universo-observavel': {
    alt: 'Mapa de todo o céu com flutuações de temperatura da radiação cósmica de fundo observadas pelo Planck.',
    text: 'O horizonte de partículas delimita a região de onde um sinal pôde nos alcançar desde o início da expansão. A distância atual até ele cresceu enquanto a luz viajava.',
    caption: 'Mapa do céu em cores atribuídas · ESA/Planck Collaboration, 2018. Vemos a superfície de última dispersão. Os 93 bilhões de anos-luz indicam o diâmetro atual aproximado do Universo observável, além dessa superfície.'
  },
  'via-lactea': {
    alt: 'Reconstrução artística externa de uma espiral barrada, com núcleo luminoso e faixas de poeira.',
    caption: 'Vista externa ilustrativa da Via Láctea · Cosmos do Zero.'
  },
  hemacia: {
    alt: 'Hemácias humanas vistas ao microscópio em uma amostra de sangue.',
    caption: 'Fotomicrografia de hemácias humanas. CDC/Dr. L. L. A. Moore, Jr. · PHIL 17516.'
  },
  'grupo-local': {
    alt: 'Mosaico infravermelho da galáxia de Andrômeda, integrante do Grupo Local.',
    caption: 'Andrômeda, uma das maiores galáxias do Grupo Local. Observação em infravermelho do WISE · NASA/JPL-Caltech/UCLA.'
  },
  'teia-cosmica': {
    alt: 'Emissão do gás de um filamento em violeta sobre um campo de galáxias observado pelo Hubble.',
    caption: 'Exemplo observado de um filamento de 3 milhões de anos-luz. A medida de 500 milhões de anos-luz se refere à Muralha de Coma. ESO/D. Tornotti et al.; Hubble: M. Revalski, P. Francis et al.'
  },
  proton: {
    alt: 'Ilustração dos três quarks de valência do próton e sua interação.',
    caption: 'Modelo dos quarks de valência. Jacek rybak · CC BY-SA 4.0. Imagem reenquadrada e convertida em WebP.'
  },
  hidrogenio: {
    text: 'O próton atrai o elétron pela força elétrica. As regiões mais claras do orbital têm maior densidade de probabilidade de detectar o elétron.',
    alt: 'Corte da densidade de probabilidade do orbital 1s, com barra de 53 picômetros.',
    caption: 'Orbital 1s do hidrogênio. O brilho representa a densidade de probabilidade, com contraste comprimido. Cosmos do Zero.'
  },
  terra: {
    alt: 'Fotografia da Terra feita pela tripulação da Apollo 17, com África, Antártida e nuvens visíveis.',
    caption: 'A tripulação da Apollo 17 fotografou a Terra durante a viagem à Lua em dezembro de 1972. NASA · AS17-148-22727.'
  },
  'sistema-solar': {
    alt: 'Fotografia do Sol e vistas texturizadas dos oito planetas em ordem de distância orbital.',
    caption: 'Montagem fora de escala. O Sol foi observado em ultravioleta extremo (17,1 nm) pela NASA/GSFC/SDO. Os discos planetários usam mapas observados e ilustrativos.'
  }
};
---
<section class="cosmic-exhibit scale-exhibit" id="escala-cosmica" aria-labelledby="scale-exhibit-title" data-scale-journey>
  <div class="page-width">
    <header class="cosmic-exhibit-heading">
      <div class="exhibit-label">Escala contínua</div>
      <h2 class="display" id="scale-exhibit-title">Do próton ao <em>universo observável.</em></h2>
      <p class="scale-hint-interactive">Role a página ou arraste a régua para mudar a escala. Cada divisão maior da régua multiplica a distância por dez bilhões.</p>
      <p class="scale-hint-static">Escolha uma parada para comparar os tamanhos e entender a física em cada escala.</p>
    </header>
    <nav class="cosmic-exhibit-nav" aria-label="Escalas da exposição">
      {scaleStations.map((stage, i) => <a href={`#escala-${stage.id}`}><span aria-hidden="true">{number(i)}</span>{stage.name}</a>)}
    </nav>
  </div>

  <div class="scale-journey-lane" data-scale-lane>
    <div class="scale-journey-visual" data-scale-visual-stage data-media="posters">
      <div class="scale-console">
        <div class="scale-console-tools">
          <span class="scale-count" data-scale-count aria-hidden="true">01 / {scaleStations.length}</span>
          <label class="visually-hidden" for="scale-jump">Ir para uma escala</label>
          <select id="scale-jump" data-scale-jump>
            {scaleStations.map((stage, i) => <option value={i}>{stage.name}</option>)}
          </select>
          <button type="button" data-scale-light aria-pressed="false">Modo leve</button>
        </div>
        <div class="scale-slider">
          <label class="visually-hidden" for="scale-slider">Régua logarítmica de tamanho em metros</label>
          <input id="scale-slider" data-scale-input type="range" min="0" max="10000" step="10" value="0" />
          <span class="scale-slider-ticks" aria-hidden="true">
            {ticks.map(tick => <span style={`--tick:${position(tick)}%`}>10<sup>{tick}</sup></span>)}
            <span class="scale-slider-unit">m</span>
          </span>
        </div>
      </div>
      <div class="scale-scene-window">
        <div class="scale-journey-canvas" data-scale-canvas data-cosmos-quality="standard">
          <div class="scale-journey-posters" data-story-poster aria-hidden="true">
            {scaleStations.map((stage, i) => <img src={i === 0 ? poster(stage.image, 600) : undefined} data-src={poster(stage.image, 600)} data-srcset={candidates(stage.image)} srcset={i === 0 ? candidates(stage.image) : undefined} sizes="(max-width: 760px) 100vw, (max-width: 1500px) 72vw, 1080px" width="600" height="400" alt="" decoding="async" />)}
          </div>
          <video class="scale-journey-video" data-scale-video={u('/models/worlds-hd/media/scale-journey.mp4')} data-compact={u('/models/worlds-hd/compact/media/scale-journey.mp4')} preload="none" muted playsinline></video>
        </div>
      </div>
      <aside class="scale-active" aria-label="Nesta escala" data-scale-active></aside>
    </div>

    <ol class="cosmic-exhibit-stages page-width" role="list">
      {scaleStations.map((stage, i) => (
        <li class="cosmic-exhibit-stage" id={`escala-${stage.id}`} tabindex="-1" data-scale-station={stage.name}>
          <div class="cosmic-exhibit-copy">
            <h3 data-scale-name>{stage.name}</h3>
            <p class="scale-exhibit-extent"><strong>{stage.extent}</strong><small>{stage.dimension}</small></p>
            <p>{plates[stage.id]?.text ?? stage.text}</p>
            <a href={stage.source} class="cosmic-exhibit-source">{stage.sourceLabel} <span aria-hidden="true">↗</span></a>
            <p class="scale-model-note">{plates[stage.id]?.caption ?? stage.caption}</p>
          </div>
          <figure class="cosmic-exhibit-plate">
            <div class="scale-exhibit-image">
              <img src={poster(stage.image, 600)} srcset={candidates(stage.image)} sizes="(max-width: 760px) 92vw, (max-width: 1230px) 54vw, 665px" width="1200" height="800" alt={plates[stage.id]?.alt ?? stage.alt} loading="lazy" decoding="async" />
            </div>
            <div class="scale-exhibit-ruler" aria-hidden="true">
              <div class="scale-exhibit-track"><span style={`--scale-position:${position(scaleLogs[i])}%`}></span></div>
              <div class="scale-exhibit-ticks">{ticks.map(tick => <span style={`--tick:${position(tick)}%`}>10<sup>{tick}</sup></span>)}</div>
              <span class="scale-exhibit-unit">m</span>
            </div>
          </figure>
        </li>
      ))}
    </ol>
  </div>
  <div class="page-width scale-journey-end">
    <a class="cosmic-exhibit-source" href={u('/models/worlds-hd/manifest.json')}>Fontes e licenças das pranchas HD</a>
    <a class="cosmic-exhibit-source" href={u('/fontes/#cenas-3d')}>Créditos das cenas e mapas <span aria-hidden="true">↗</span></a>
    <a class="cosmic-exhibit-source scale-exhibit-next" href={`${chapterUrl('galaxias-e-nebulosas')}#galaxias-e-nebulosas-teia-cosmica`}>Investigue como se forma a teia cósmica <span aria-hidden="true">→</span></a>
  </div>
</section>
<script>
  import { initScaleJourneys } from '../scripts/scale-journey';
  initScaleJourneys();
</script>
