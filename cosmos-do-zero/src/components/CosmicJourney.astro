---
import '../styles/journey.css';
import { eras } from '../data';
import { chapterUrl, u } from '../lib/url';
import { pad2 } from '../lib/format';
import { JOURNEY_ERAS } from '../lib/journey';
import jades from '../data/journey-jades.json';
import eraPlates from '../../public/renders/journey-hd/manifest.json';

const allPlates = [...eraPlates, {
  ...jades, id: 'galaxies', small: '/photos/journey/jades-880.webp',
  large: '/photos/journey/jades-2211.webp', width: 2211, height: 1685,
}];
const marks = JOURNEY_ERAS.map(id => {
  const era = eras.find(item => item.id === id);
  const plate = allPlates.find(item => item.id === id);
  if (!era || !plate) throw new Error('Imagem ou época ausente: ' + id);
  const kind = plate.kind === 'illustration' ? 'Ilustração' : plate.kind === 'observation' ? 'Observação' : plate.kind;
  return { ...era, plate: { ...plate, kind } };
});
const total = pad2(marks.length);
---
<section class="journey" id="viagem" data-home-section="04" aria-labelledby="journey-title" data-journey>
  <div class="journey-intro page-width">
    <h2 class="display" id="journey-title">História do Universo</h2>
    <p class="journey-lede">A sequência cobre cerca de 13,8 bilhões de anos, da fase quente e densa ao Universo observado hoje. Role a página para avançar pelos {marks.length} marcos.</p>
    <a class="textlink" href="#capitulos">Voltar às aulas <span aria-hidden="true">↑</span></a>
  </div>
  <div class="journey-body">
    <div class="journey-stage">
      <canvas data-journey-canvas role="img" aria-label={marks[0].plate.caption}></canvas>
      <p class="journey-missing" data-journey-missing hidden>Imagem indisponível. A descrição está no cartão desta etapa.</p>
      <div class="journey-hud">
        <div class="journey-transport">
          <label>Marco <select data-journey-select>{marks.map((era,i)=><option value={i}>{era.title}</option>)}</select></label>
          <button type="button" data-journey-pause aria-pressed="false">Pausar movimento</button>
        </div>
        <span class="journey-when" data-journey-when>{marks[0].short}</span>
      </div>
      <div class="journey-rail">
        {marks.map((_, i) => <i class:list={[i === 0 && 'is-active']} data-journey-tick></i>)}
      </div>

    </div>
    <ol class="journey-steps">
      {marks.map((era, i) => (
        <li class:list={['journey-step', i === 0 && 'is-active']} data-journey-step={i} id={`viagem-${era.id}`} data-journey-era={era.id} data-journey-large={u(era.plate.large)} data-journey-aspect={era.plate.width / era.plate.height} data-journey-short={era.short}>
          <article>
            <img class="journey-still" data-journey-still src={u(era.plate.small)}
              width={880} height={Math.round(880 * era.plate.height / era.plate.width)}
              loading="lazy" decoding="async" alt={era.plate.caption} />
            <p class="journey-step-count">{pad2(i + 1)} / {total}</p>
            <p class="journey-step-time">{era.short}</p>
            <h3>{era.title}</h3>
            <p class="journey-step-text">{era.text}</p>
            <p class="journey-step-evidence"><b>Como sabemos</b> {era.evidence}</p>
            <details class="journey-photo-credit">
              <summary>{era.plate.kind} <span aria-hidden="true">＋</span></summary>
              <p>{era.plate.caption}</p>
              <p>{era.plate.source ? <a href={era.plate.source}>{era.plate.credit}</a> : era.plate.credit}</p>
            </details>
            <a class="textlink" href={chapterUrl(era.chapter)}>Entrar nesta aula <span aria-hidden="true">↗</span></a>
          </article>
        </li>
      ))}
    </ol>
  </div>
</section>
