---
import { Image } from 'astro:assets';
import atmosphere from '../assets/photos/iss-sunrise.webp';
import { imageCredits } from '../data';
import { studies, measurement, number, wave } from '../lib/atlas-studies';
import { u } from '../lib/url';
import type { ChapterId } from '../types';
interface Props { id: ChapterId }
const { id }=Astro.props;
const s=studies[id];
const art=(name:string)=>u('/models/atlas-studies/plates/'+name+'.webp');
const divisions=Array.from({length:21},(_,i)=>i);
---
{s && <section class="atlas-study" data-study={s.key} data-model={u('/models/atlas-studies/'+s.key+'.glb')} aria-labelledby={'study-'+s.key} id="prancha">
  <header><p>Experimento de capítulo</p><h2 id={'study-'+s.key}>{s.title}</h2><p>{s.prediction}</p></header>
  <div class="study-console">
    <figure>
      <div class="study-viewport" style={s.key==='air' ? undefined : {backgroundImage:`url(${art('sky')})`}}>
        {s.key==='air' && <Image class="study-horizon" src={atmosphere} alt="" width={800} loading="lazy"/>}
        <svg viewBox="0 0 360 180" role="img" aria-label={'Comparação entre '+s.reference+' e '+s.sample+'. O resultado numérico acompanha o controle.'}>
          <defs>
            <linearGradient id="sample-column"><stop stop-color="#7b3e24"/><stop offset=".35" stop-color="#ec9f61"/><stop offset=".64" stop-color="#fad0a1"/><stop offset="1" stop-color="#925435"/></linearGradient>
            <linearGradient id="ref-column"><stop stop-color="#2b5866"/><stop offset=".38" stop-color="#76b9c7"/><stop offset=".64" stop-color="#c4e3e5"/><stop offset="1" stop-color="#4f8794"/></linearGradient>
          </defs>
          {s.key==='redshift' && <>
            {[{y:55,tag:'Emissão'},{y:128,tag:'Observação'}].map(({y,tag})=><g>
              <text class="measure-label" x="18" y={y-25}>{tag}</text>
              <path d={`M18 ${y}H344`} class="rail"/>
              <path d={`M18 ${y+21}H344`} class="rule"/>
              {divisions.map(i=><path d={`M${18+i*16} ${y+21}v${i%5===0?7:3}`} class="rule"/>)}
            </g>)}
            <polyline class="ref" points={wave(52)} transform="translate(0 55)"/>
            <polyline data-measure class="sample" points={wave(52)} transform="translate(0 128)"/>
            <path data-bracket d="M18 144V140M18 142H70M70 140V144" class="sample-bracket"/>
          </>}
          {s.key==='lens' && <>
            <image href={art('lens-galaxy')} x="109" y="19" width="142" height="142"/>
            <image data-measure href={art('einstein')} x="129.6" y="39.6" width="100.8" height="100.8"/>
            <circle class="ref ring" cx="180" cy="90" r="36"/>
            <path d="M22 90H63M297 90H338M180 8V15M180 165V172" class="rule"/>
          </>}
          {s.key==='star' && <>
            <image href={art('photosphere')} x="48.4" y="50.4" width="81.2" height="81.2"/>
            <image data-measure href={art('photosphere')} x="201.4" y="50.4" width="81.2" height="81.2"/>
            <path d="M60 161H118M60 158V164M118 158V164" class="ref-rule"/>
            <path data-bracket d="M213 161H271M213 158V164M271 158V164" class="sample-bracket"/>
          </>}
          {s.key==='orbit' && <>
            <ellipse class="sample ring" data-measure cx="179" cy="91" rx="55" ry="28"/>
            <ellipse class="ref ring" cx="179" cy="91" rx="55" ry="28"/>
            <image href={art('photosphere')} x="149" y="61" width="60" height="60"/>
            <image data-planet href={u('/models/portraits/terra.webp')} x="224" y="81" width="20" height="20"/>
          </>}
          {s.key==='air' && <>
            {[{x:99,bar:'ref-column'},{x:229,bar:'sample-column'}].map(({x,bar},i)=><g>
              <rect x={x-8} y="23" width="55" height="136" rx="3" fill="#061323" fill-opacity=".76" stroke="#9badaf" stroke-width=".5"/>
              <rect x={x} y="31" width="26" height="119" rx="2" fill={'url(#'+bar+')'} data-measure={i===1?'':undefined}/>
              {divisions.filter(j=>j%2===0).map(j=><path d={`M${x+30} ${31+j*5.95}h${j%10===0?9:5}`} stroke="#b5c4c3" stroke-width=".8"/>)}
            </g>)}
            <text class="measure-label" x="49" y="34">100%</text><text class="measure-label" x="55" y="94">50%</text><text class="measure-label" x="61" y="150">0%</text>
          </>}
        </svg>
        <canvas data-study-canvas hidden aria-label={'Representação tridimensional de '+s.title} role="img"></canvas>
      </div>
      <figcaption><span>{s.reference}</span><span>{s.sample}</span></figcaption>
    </figure>
    <div class="study-input">
      <label for={'control-'+s.key}>{s.input} <output data-study-in>{number(s.initial)} {s.unit}</output></label>
      <input id={'control-'+s.key} data-unit={s.unit} type="range" min={s.min} max={s.max} step={s.step} value={s.initial}/>
      <span>{s.reading}</span><output class="study-answer" for={'control-'+s.key} data-study-out data-unit={s.outUnit}>{number(measurement(s.key,s.initial))} {s.outUnit}</output>
      <p>{s.rule}</p><button type="button" data-study-toggle aria-pressed="false">Abrir modelo 3D</button><small data-study-status role="status"></small>
    </div>
  </div>
  <p class="study-limit">{s.limit} {s.key==='air' && <a href={imageCredits[2].href} target="_blank" rel="noopener noreferrer">Fotografia da Expedição 70 · NASA/JSC ↗</a>}{s.key==='orbit' && <a href="https://science.nasa.gov/earth/earth-observatory/blue-marble-next-generation/base-map/" target="_blank" rel="noopener noreferrer">Textura terrestre · NASA/MODIS ↗</a>}</p><details><summary>Conferir a previsão</summary><p>{s.result}</p></details>
</section>}
<script>
  import { measurement, number, wave, type StudyKey } from '../lib/atlas-studies';
  for(const section of document.querySelectorAll<HTMLElement>('[data-study]')) {
    const key=section.dataset.study as StudyKey;
    const svg=section.querySelector('svg')!;
    const canvas=section.querySelector('canvas')!;
    const range=section.querySelector('input')!;
    const out=section.querySelector<HTMLOutputElement>('[data-study-out]')!;
    const current=section.querySelector<HTMLOutputElement>('[data-study-in]')!;
    const toggle=section.querySelector('button')!;
    const status=section.querySelector<HTMLElement>('[data-study-status]')!;
    const shape=svg.querySelector('[data-measure]')!;
    let scene:Awaited<ReturnType<typeof import('../scripts/atlas-study-scene').openStudy>>|undefined;
    const update=()=>{
      const v=Number(range.value), y=measurement(key,v);
      current.value=number(v)+' '+range.dataset.unit;
      range.setAttribute('aria-valuetext',current.value);
      out.value=number(y)+' '+out.dataset.unit;
      if(key==='redshift'){
        const length=52*(1+v);
        shape.setAttribute('points',wave(length));
        svg.querySelector('[data-bracket]')!.setAttribute('d',`M18 150v-4m0 2h${length}m0 -2v4`);
      }
      if(key==='lens'||key==='star'){
        const cx=key==='lens'?180:242, cy=key==='lens'?90:91;
        const r=key==='lens'?36*y:29*v, size=2.8*r;
        for(const [attr,value] of Object.entries({width:size,height:size,x:cx-size/2,y:cy-size/2})) shape.setAttribute(attr,String(value));
        svg.querySelector('[data-bracket]')?.setAttribute('d',`M${cx-r} 158v6m0 -3h${2*r}m0 -3v6`);
      }
      if(key==='orbit'){
        shape.setAttribute('rx',String(55*v)); shape.setAttribute('ry',String(28*v));
        svg.querySelector('[data-planet]')!.setAttribute('x',String(179+55*v-10));
      }
      if(key==='air'){
        const height=119*y/100;
        shape.setAttribute('height',String(height));shape.setAttribute('y',String(150-height));
      }
      scene?.update(v);
    };
    const close=()=>{scene?.close();scene=undefined;canvas.hidden=true;svg.removeAttribute('hidden');toggle.textContent='Abrir modelo 3D';toggle.setAttribute('aria-pressed','false');};
    range.addEventListener('input',update); update();
    toggle.addEventListener('click',async()=>{
      if(scene){close();status.textContent='Diagrama 2D ativo.';return;}
      toggle.disabled=true;status.textContent='Carregando o modelo…';
      try{
        const {openStudy}=await import('../scripts/atlas-study-scene');
        canvas.hidden=false;
        scene=await openStudy(canvas,key,section.dataset.model!);
        update();svg.setAttribute('hidden','');
        toggle.textContent='Voltar ao diagrama 2D';toggle.setAttribute('aria-pressed','true');status.textContent='Modelo 3D ativo.';
      }catch(error){console.warn('[cosmos] Prancha 3D',key,String(error));close();status.textContent='O 3D está indisponível. Use a régua no diagrama 2D.';}
      finally{toggle.disabled=false;}
    });
    canvas.addEventListener('webglcontextlost',()=>{close();status.textContent='Diagrama 2D ativo.';});
    addEventListener('pagehide',close);
  }
</script>
<style>
.atlas-study{background:var(--atlas-paper,#f4f1e8);color:var(--atlas-ink,#192327);border-block:1px solid var(--atlas-rule,#b4b8ac);padding:clamp(16px,3vw,42px);margin-block:38px;scroll-margin-top:80px}
.atlas-study header>p:first-child,.study-input>span{font:600 .7rem/1.4 var(--atlas-mono,monospace);text-transform:uppercase;letter-spacing:.08em}
.atlas-study h2{font:500 clamp(28px,3.7vw,56px)/1.08 Georgia,serif;letter-spacing:-.035em;margin:7px 0 12px;color:inherit}
.atlas-study p{line-height:1.55}.atlas-study header>p{margin:0}
.study-console{display:grid;grid-template-columns:minmax(0,1.55fr) minmax(0,1fr);margin-block:18px;align-items:stretch;gap:clamp(14px,2vw,30px)}
.study-console figure{margin:0;background:#060b12;color:#e6e9e9;display:flex;flex-direction:column;justify-content:center;min-width:0}
.study-viewport{position:relative;isolation:isolate;aspect-ratio:2/1;width:100%;background:#060b12 center/cover}
.study-horizon{position:absolute;width:100%;height:100%;object-fit:cover;object-position:50% 43%;opacity:.73;z-index:-1}
.study-console svg,.study-console canvas{display:block;width:100%;height:100%;position:absolute;inset:0}.study-console [hidden]{display:none}
.study-console figcaption{padding:10px 13px;background:#0b151f;border-top:1px solid #273444;display:flex;gap:8px 18px;flex-wrap:wrap;font:500 .74rem/1.4 var(--atlas-mono,monospace)}
figcaption span:before{content:'';display:inline-block;width:16px;border-bottom:2px dashed #91d2db;margin-right:5px;vertical-align:middle}figcaption span+span:before{border-bottom:2px solid #f0a66d}
[data-study=lens] figcaption span:before{border-color:#ce9971}[data-study=lens] figcaption span+span:before{border-color:#d0def9}
.ref,.sample{stroke:#9ecddb;stroke-width:1.6;fill:none}.sample{stroke:#f7b981;stroke-width:2.1}.ref.ring{stroke-width:.8;stroke-dasharray:2.4 3}.sample.ring{stroke-width:1.3}
[data-study=lens] .ref.ring{stroke:#d7a16d}
.rule,.rail,.ref-rule,.sample-bracket{fill:none;stroke:#889cab;stroke-width:.65}.rail{stroke:#354653}.ref-rule{stroke:#9bc8d3}.sample-bracket{stroke:#edb183}
.measure-label{font:8.2px var(--atlas-mono,monospace);fill:#d7e1e8;letter-spacing:.035em}
.study-input{display:grid;align-content:center;gap:5px}.study-input label{display:flex;justify-content:space-between;gap:8px;font-weight:650}
.study-input input{width:100%;min-height:40px;accent-color:#b05229}.study-answer{font:500 clamp(27px,3.4vw,48px)/1.1 Georgia,serif}.study-input p,.study-limit{font-size:.87rem;margin:4px 0}
.study-input button{color:inherit;background:transparent;border:1px solid currentColor;justify-self:start;padding:8px 11px;min-height:44px;cursor:pointer}.study-input small{font-size:.8rem}.atlas-study details{margin-top:12px}.atlas-study summary{cursor:pointer;text-decoration:underline;text-underline-offset:3px;min-height:44px}
@media(max-width:700px){.study-console{grid-template-columns:1fr}.atlas-study{padding:16px}.study-input{gap:3px}}
</style>
