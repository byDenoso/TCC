---
import { eras } from '../data';
import { u, chapterUrl } from '../lib/url';
import { pad2 } from '../lib/format';
const first = eras[0];
const eraRenders: Record<string, string> = { 'primordial': 'plasma', 'nucleosynthesis': 'nuclei', 'cmb': 'cmb', 'dark-ages': 'dark-ages', 'first-stars': 'star', 'reionization': 'reionization', 'galaxies': 'galaxies', 'acceleration': 'cosmic-web', 'solar-system': 'solar-system', 'earth': 'earth', 'oxygen': 'earth', 'present': 'cosmic-web' };
const altByEra: Record<string, string> = {
  cmb: 'Mapa ilustrativo do céu na CMB, com contraste ampliado.',
  primordial: 'Esquema de plasma primordial, com luz, elétrons e núcleos.',
  nucleosynthesis: 'Esquema dos primeiros núcleos, com partículas ampliadas.',
  'dark-ages': 'Esquema da Idade das Trevas cósmica. Pontos suaves representam gás neutro antes das primeiras estrelas.',
  reionization: 'Esquema da reionização. Regiões azuis de gás ionizado cercam fontes de luz ultravioleta, com gás neutro ao redor.',
};
const eraAlt = (id: string, title: string) => altByEra[id] ?? `Representação ilustrativa para ${title}, fora de escala.`;
const eraRender = (id: string) => eraRenders[id] ?? 'cosmic-web';
---
<section class="timeline-section dark" id="tempo" aria-labelledby="timeline-title" data-island="timeline">
  <div class="page-width">
    <div class="timeline-head">
      <h2 class="display" id="timeline-title">Linha do tempo<br /><em>do Universo</em></h2>
      <p>Selecione um marco para ver sua data aproximada e as evidências usadas para estimá-la.</p>
    </div>
    <div class="timeline-window">
      <figure class={`timeline-visual ${first.visual}`} data-era="0" data-timeline-visual>
        <img class="era-render" data-era-render src={u(`/posters/${eraRender(first.id)}.webp`)} srcset={`${u(`/posters/${eraRender(first.id)}-small.webp`)} 600w, ${u(`/posters/${eraRender(first.id)}.webp`)} 1200w`} sizes="(max-width: 760px) calc(100vw - 34px), 45vw" alt={eraAlt(first.id,first.title)} width="1200" height="800" loading="lazy" decoding="async" />
        <span class="era-number" data-era-number>01 / {pad2(eras.length)}</span>
        <figcaption class="era-bottom">Ilustração fora de escala</figcaption>
      </figure>
      <div class="timeline-detail" aria-live="polite" aria-atomic="true">
        <div class="detail-kicker" data-era-evidence>{first.evidence}</div>
        <div class="detail-time" data-era-time>{first.time}</div>
        <h3 data-era-title>{first.title}</h3>
        <p data-era-text>{first.text}</p>
        <a class="textlink" data-era-link href={chapterUrl(first.chapter)}>Entrar neste capítulo <span aria-hidden="true">↗</span></a>
      </div>
    </div>
    <div class="time-nav" role="group" aria-label="Marcos da história do Universo" data-era-nav>
      {eras.map((e, i) => (
        <button type="button" class:list={['time-event', i === 0 && 'active']} data-era-index={i} data-era-id={e.id} data-render-alt={eraAlt(e.id,e.title)} data-render-src={u(`/posters/${eraRender(e.id)}.webp`)} aria-pressed={i === 0 ? 'true' : 'false'}>
          <b>{e.title}</b><span>{e.short}</span>
        </button>
      ))}
    </div>
    <div class="time-scrubber"><label for="era-range">Escolha um marco</label><input id="era-range" data-era-range disabled type="range" min="0" max={eras.length-1} step="1" value="0" aria-valuetext={first.title} /></div>
    <div class="timeline-controls">
      <button type="button" data-era-prev disabled>← Anterior</button>
      <span data-era-position>01 / {pad2(eras.length)}</span>
      <button type="button" data-era-next>Próximo →</button>
    </div>
    <p class="timeline-footnote">Datas aproximadas. Cada marco ocupa o mesmo espaço na tela e as durações variam. “Depois” conta a partir da fase quente. “Atrás” conta a partir de hoje. <a class="textlink" href="https://science.nasa.gov/mission/webb/early-universe/">Cronologia do Universo primordial na NASA <span aria-hidden="true">↗</span></a></p>
  </div>
</section>
