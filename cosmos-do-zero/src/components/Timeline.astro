---
import { eras } from '../data';
import { u, chapterUrl } from '../lib/url';
import { pad2 } from '../lib/format';
const first = eras[0];
const eraRenders: Record<string, string> = { 'primordial': 'ancient-light', 'nucleosynthesis': 'ancient-light', 'cmb': 'ancient-light', 'first-stars': 'star', 'galaxies': 'galaxies', 'acceleration': 'cosmic-web', 'solar-system': 'solar-system', 'earth': 'earth', 'oxygen': 'earth', 'present': 'cosmic-web' };
const eraRender = (id: string) => eraRenders[id] ?? 'cosmic-web';
---
<section class="timeline-section dark" id="tempo" aria-labelledby="timeline-title" data-island="timeline">
  <div class="page-width">
    <div class="section-id">02 / A história em perspectiva</div>
    <div class="timeline-head">
      <h2 class="display" id="timeline-title">O tempo muda.<br /><em>Tudo muda com ele.</em></h2>
      <p>Dos primeiros núcleos ao ar que você respira. Navegue pelos marcos e entre na história.</p>
    </div>
    <div class="timeline-window">
      <figure class={`timeline-visual ${first.visual}`} data-era="0" data-timeline-visual>
        <img class="era-render" data-era-render src={u(`/renders/${eraRender(first.id)}.webp`)} srcset={`${u(`/renders/${eraRender(first.id)}-small.webp`)} 600w, ${u(`/renders/${eraRender(first.id)}.webp`)} 1200w`} sizes="(max-width: 760px) calc(100vw - 34px), 45vw" alt={`Representação artística para ${first.title}; sem escala física.`} width="1200" height="800" loading="lazy" decoding="async" />
        <span class="era-number" data-era-number>01 / {pad2(eras.length)}</span>
        <figcaption class="era-bottom" data-era-render-note>Render conceitual por IA · sem escala</figcaption>
      </figure>
      <div class="timeline-detail" aria-live="polite" aria-atomic="true">
        <div class="detail-kicker" data-era-evidence>{first.evidence}</div>
        <div class="detail-time" data-era-time>{first.time}</div>
        <h3 data-era-title>{first.title}</h3>
        <p data-era-text>{first.text}</p>
        <a class="textlink" data-era-link href={chapterUrl(first.chapter)}>Entrar neste capítulo <span aria-hidden="true">↗</span></a>
      </div>
    </div>
    <div class="time-nav" role="group" aria-label="Marcos da história do Universo" data-era-nav>
      {eras.map((e, i) => (
        <button type="button" class:list={['time-event', i === 0 && 'active']} data-era-index={i} data-render-src={u(`/renders/${eraRender(e.id)}.webp`)} aria-pressed={i === 0 ? 'true' : 'false'}>
          <b>{e.title}</b><span>{e.short}</span>
        </button>
      ))}
    </div>
    <div class="timeline-controls">
      <button type="button" data-era-prev disabled>← Anterior</button>
      <span data-era-position>01 / {pad2(eras.length)}</span>
      <button type="button" data-era-next>Próximo →</button>
    </div>
    <p class="timeline-footnote">Marcos igualmente espaçados para facilitar a navegação. A distância na interface não representa duração. Datas aproximadas; “depois” conta a partir da fase quente, “atrás” conta a partir de hoje. As imagens ilustram o tema de cada marco e não reconstroem a aparência daquela época: uma Terra ou uma galáxia de aspecto moderno não é uma imagem do passado.</p>
  </div>
</section>
