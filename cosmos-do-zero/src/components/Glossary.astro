---
import { terms, chapterTitleShort } from '../data';
import { chapterUrl } from '../lib/url';
import { CHAPTER_IDS } from '../types';
import { countLabel } from '../lib/glossary';
interface Props { headingLevel?: 'h1' | 'h2' }
const Title = Astro.props.headingLevel ?? 'h2';
---
<section class="glossary-section paper" id="glossario" aria-labelledby="glossary-title" data-island="glossary">
  <div class="page-width">
    <div class="intro-head">
      <Title class="display" id="glossary-title">Dicionário do cosmos</Title>

    </div>
    <form class="glossary-search" role="search" onsubmit="return false">
      <label for="glossary-search">O que você quer entender?</label>
      <div class="glossary-input-wrap">
        <input type="search" id="glossary-search" data-glossary-input placeholder="Ex.: ano-luz, gravidade, fusão…" autocomplete="off" spellcheck="false" />
        <button type="button" class="glossary-reset" data-glossary-reset aria-label="Limpar o texto da busca" hidden>×</button>
      </div>
      <span role="status" data-glossary-count>{countLabel(terms.length)}</span>
    </form>
    <div class="glossary-chips" role="group" aria-label="Filtrar por jornada">
      <button type="button" data-glossary-chip="" aria-pressed="true">Todas</button>
      {CHAPTER_IDS.map((id) => <button type="button" data-glossary-chip={id} aria-pressed="false">{chapterTitleShort[id]}</button>)}
    </div>
    <div class="glossary-list" data-glossary-list>
      {terms.map((t, i) => (
        <details class="glossary-entry" id={`termo-${i}`} data-term-index={i}>
          <summary>{t.term}<span aria-hidden="true">+</span></summary>
          <div>
            <p>{t.definition}</p>
            <p class="glossary-example"><strong>Exemplo.</strong> {t.example}</p>
            <a class="textlink" href={chapterUrl(t.chapter)}>Ver a ideia em contexto: {chapterTitleShort[t.chapter]} <span aria-hidden="true">↗</span></a>
          </div>
        </details>
      ))}
    </div>
    <div class="glossary-empty" data-glossary-empty hidden>
      <p>Nenhum termo encontrado. Tente outra palavra, como “luz” ou “estrela”.</p>
      <div class="glossary-suggest" data-glossary-suggest-wrap hidden><span>Você quis dizer:</span><div data-glossary-suggest></div></div>
      <button type="button" class="textlink" data-glossary-clear>Limpar a busca e ver todos os termos</button>
    </div>
  </div>
</section>
