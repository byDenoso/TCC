---
import '../styles/scenes.css';
import { u } from '../lib/url';
import ScaleArt from './ScaleArt.astro';
interface Props { experience: 'scale' | 'expansion' | 'evidence'; }
const { experience } = Astro.props;
const scales = [
  { name: 'Terra', unit: '12.742 km de diâmetro médio', title: 'Nossa casa tem endereço.', body: 'A Terra é um planeta em órbita do Sol. Seu diâmetro é pequeno diante das distâncias que separam as estrelas.', light: 'A luz da Lua leva cerca de 1,3 segundo para chegar aqui.' },
  { name: 'Sistema Solar', unit: '1 UA ≈ 150 milhões de km', title: 'O Sol é a nossa estrela.', body: 'Uma unidade astronômica (UA) é aproximadamente a distância média entre a Terra e o Sol. O Sistema Solar inclui planetas e regiões muito além de Netuno.', light: 'A luz do Sol leva cerca de 8 minutos e 20 segundos para chegar à Terra.' },
  { name: 'Via Láctea', unit: 'Disco estelar: cerca de 100 mil anos-luz', title: 'Vivemos dentro de uma galáxia.', body: 'O Sol é uma entre centenas de bilhões de estrelas da Via Láctea. Um ano-luz mede distância: o caminho que a luz percorre em um ano.', light: 'A luz de uma estrela a 100 anos-luz mostra como ela era há 100 anos.' },
  { name: 'Outras galáxias', unit: 'Andrômeda: cerca de 2,5 milhões de anos-luz', title: 'Nossa galáxia tem vizinhas.', body: 'A Via Láctea e Andrômeda pertencem ao Grupo Local. Galáxias podem formar grupos e aglomerados unidos pela gravidade.', light: 'Vemos Andrômeda como era há cerca de 2,5 milhões de anos.' },
  { name: 'Teia cósmica', unit: 'Estruturas com milhões de anos-luz', title: 'A matéria forma uma grande rede.', body: 'Em escalas maiores, galáxias se distribuem em filamentos e aglomerados, separados por vazios. Esta representação artística ilustra essa organização.', light: 'Em distâncias cosmológicas, a expansão também participa da relação entre distância e tempo de viagem da luz.' }
];
const evidence = [
  { name: 'Expansão', key: 'expansion', observation: 'Os espectros de muitas galáxias mostram desvio para o vermelho. Em grandes escalas, distância e recessão se relacionam.', explanation: 'Um espaço em expansão estica a luz durante sua viagem. Movimentos locais também podem alterar o espectro.', uncertainty: 'Os métodos de medição da expansão atual ainda chegam a valores diferentes. Entender essa diferença é uma pesquisa em aberto.' },
  { name: 'Fundo cósmico', key: 'cmb', observation: 'Detectamos radiação de micro-ondas em todas as direções, com espectro térmico e pequenas diferenças de temperatura.', explanation: 'É uma luz antiga, liberada quando o Universo se tornou transparente, cerca de 380 mil anos após o início da expansão quente.', uncertainty: 'Seus padrões restringem modelos. Não são uma fotografia do instante inicial nem uma prova de todas as hipóteses sobre esse instante.' },
  { name: 'Matéria escura', key: 'matter', observation: 'Movimentos de estrelas e galáxias, lentes gravitacionais e padrões do fundo cósmico indicam gravidade além da matéria luminosa.', explanation: 'O modelo cosmológico usa matéria que exerce gravidade e interage pouco com a luz para reunir essas evidências.', uncertainty: 'A identidade microscópica dessa matéria ainda é desconhecida. Não houve identificação confirmada de sua partícula.' },
  { name: 'Expansão acelerada', key: 'acceleration', observation: 'Distâncias de supernovas do tipo Ia, combinadas com outras observações, sustentam uma expansão acelerada recente.', explanation: 'A constante cosmológica é a descrição mais simples da energia escura no modelo padrão.', uncertainty: 'Sua natureza física permanece aberta. Estudar possíveis variações exige combinar dados, erros e hipóteses do modelo.' }
];
const evidenceRenders = ['galaxies', 'ancient-light', 'dark-matter', 'cosmic-web'];
const grid = Array.from({ length: 25 }, (_, i) => ({ x: (i % 5 - 2) * 58, y: (Math.floor(i / 5) - 2) * 48, id: i }));
---
<section class="cosmos-scene page-width" id="exploracao" data-scene={experience} aria-labelledby="scene-title">
  <div class="scene-heading"><h2 id="scene-title">{experience === 'scale' ? 'Onde estamos no Universo?' : experience === 'expansion' ? 'O que significa o espaço expandir?' : 'Como sabemos o que sabemos?'}</h2><p>{experience === 'scale' ? 'Mude de escala e acompanhe o caminho da luz.' : experience === 'expansion' ? 'Aumente a escala da malha e troque o observador.' : 'Escolha uma evidência. Observe o que ela mostra, como interpretamos e o que segue aberto.'}</p></div>
  {experience === 'scale' && <>
    <div class="scene-controls" role="group" aria-label="Escolher escala">{scales.map((s, i) => <button type="button" data-scale-step={i} aria-pressed={i === 0 ? 'true' : 'false'}>{String(i + 1).padStart(2, '0')} · {s.name}</button>)}</div>
    <div class="scene-split">
      <figure class="scene-canvas scale-canvas">
        <svg class="scale-svg" viewBox="0 0 600 400" role="img" aria-label="Ilustração da escala escolhida: Terra, Sistema Solar, Via Láctea, galáxias vizinhas ou teia cósmica." data-scale-svg><ScaleArt hidden={scales.map((_, i) => i !== 0)} /></svg>
      </figure>
      <div class="scene-reading">{scales.map((s, i) => <article data-scale-panel={i} class="scene-panel"><span class="scene-unit">{s.unit}</span><h3>{s.title}</h3><p>{s.body}</p><p class="light-insight">{s.light}</p></article>)}</div>
    </div>
    <div class="light-lab"><div><h3>Olhar longe é olhar para trás.</h3><p>A fonte emite um pulso. Nós só a vemos quando a luz chega. A animação usa um trajeto fixo e tempo acelerado para mostrar esse atraso.</p></div><div><svg viewBox="0 0 500 90" role="img" aria-label="Pulso de luz viajando de uma fonte até o observador"><path d="M45 45H450" fill="none" style="stroke:var(--line-strong)" stroke-dasharray="4 7"/><circle cx="45" cy="45" r="16" style="fill:var(--c-rad)"/><circle data-light-pulse cx="45" cy="45" r="5" style="fill:var(--ink)"/><circle cx="450" cy="45" r="13" style="fill:var(--accent)"/><text x="18" y="82">Fonte</text><text x="396" y="82">Você</text></svg><button type="button" data-light-play aria-pressed="false">Iniciar viagem da luz</button><p data-light-status role="status">O pulso ainda está na fonte.</p></div></div>
  </>}
  {experience === 'expansion' && <>
    <div class="scene-split"><figure class="scene-canvas expansion-canvas"><svg viewBox="0 0 620 420" role="img" aria-labelledby="expansion-svg-title"><title id="expansion-svg-title">Malha de galáxias com separações que aumentam igualmente</title><defs><pattern id="exp-grid" width="30" height="30" patternUnits="userSpaceOnUse"><path d="M30 0H0V30" fill="none" style="stroke:var(--line)" stroke-width=".6"/></pattern></defs><rect width="620" height="420" fill="url(#exp-grid)"/>
      <g transform="translate(310 190)">{grid.map((g) => <g data-expansion-galaxy data-x={g.x} data-y={g.y} data-galaxy-id={g.id} transform={`translate(${g.x} ${g.y})`}><image data-galaxy-body href={u('/renders/galaxy-marker.png')} x="-16" y="-16" width="32" height="32" aria-hidden="true" /><circle data-observer-ring r="18" fill="none" style="stroke:var(--accent)" stroke-dasharray="3 3" data-hidden={g.id !== 12 ? "true" : "false"}/></g>)}</g><text x="28" y="397">Recorte de uma malha homogênea · sem borda física</text></svg></figure>
    <div class="scene-reading"><label class="scene-slider" for="cosmic-scale">Fator de escala <output data-expansion-value for="cosmic-scale">1,00 ×</output><input id="cosmic-scale" data-expansion-scale type="range" min="1" max="1.6" step=".01" value="1" /></label><label class="scene-select" for="cosmic-observer">Observador destacado<select id="cosmic-observer" data-expansion-observer><option value="12">Galáxia do meio do desenho</option><option value="11">Galáxia à esquerda</option><option value="13">Galáxia à direita</option></select></label><button type="button" data-expansion-play aria-pressed="false">Animar a expansão</button><h3>Nenhuma galáxia ganha um privilégio.</h3><p>Todas as separações entre galáxias da malha crescem pelo mesmo fator. Trocar o observador coloca outra galáxia no meio do enquadramento. As demais continuam se afastando pela mesma regra. O centro deste desenho é só uma escolha de quem observa.</p><p>A malha representa grandes escalas. Galáxias reais também possuem movimentos locais e não ficam em uma grade.</p></div></div>
    <div class="expansion-insets"><figure><img class="bound-system-render" data-bound-system src={u('/renders/solar-system.webp')} srcset={`${u('/renders/solar-system-small.webp')} 600w, ${u('/renders/solar-system.webp')} 1200w`} sizes="(max-width: 480px) calc(100vw - 90px), 42vw" alt="Representação artística do Sistema Solar, mantida fixa ao aumentar a escala da malha." width="1200" height="800" loading="lazy" decoding="async" /><figcaption><strong>Um sistema ligado permanece do mesmo tamanho nesta experiência.</strong> A gravidade local domina: o Sistema Solar não acompanha a expansão da malha. Render conceitual por IA; tamanhos e distâncias sem escala.</figcaption></figure><figure><svg viewBox="0 0 300 125" role="img" aria-label="O comprimento de onda aumenta com o fator de escala"><path data-expansion-wave d="M20 62Q30 27 40 62T60 62T80 62T100 62T120 62T140 62T160 62T180 62T200 62T220 62T240 62T260 62T280 62" fill="none" style="stroke:var(--accent)" stroke-width="3"/></svg><figcaption><strong>A luz livre pode ter seu comprimento de onda esticado.</strong> Na expansão cosmológica, o comprimento de onda cresce com o fator de escala.</figcaption></figure></div>
  </>}
  {experience === 'evidence' && <>
    <div class="scene-controls evidence-controls" role="group" aria-label="Escolher evidência">{evidence.map((e,i) => <button type="button" data-evidence-select={i} aria-pressed={i === 0 ? 'true' : 'false'}><span>{String(i+1).padStart(2,'0')}</span>{e.name}</button>)}</div>
    {evidence.map((e,i) => <article class="evidence-panel" data-evidence-panel={i}>
      <figure class="evidence-visual"><img class="scene-render" src={u(`/renders/${evidenceRenders[i]}.webp`)} srcset={`${u(`/renders/${evidenceRenders[i]}-small.webp`)} 600w, ${u(`/renders/${evidenceRenders[i]}.webp`)} 1200w`} sizes="(max-width: 850px) calc(100vw - 90px), 40vw" alt={i === 1 ? 'Representação artística da luz antiga do Universo; não é mapa da radiação cósmica de fundo.' : `Representação artística para a ideia de ${e.name.toLowerCase()}; não contém dados observacionais.`} width="1200" height="800" loading="lazy" decoding="async" /></figure>
      <div class="evidence-explanation"><h3>{e.name}</h3><dl><dt>O que observamos</dt><dd>{e.observation}</dd><dt>Como explicamos</dt><dd>{e.explanation}</dd><dt>O que segue aberto</dt><dd>{e.uncertainty}</dd></dl></div>
    </article>)}
  </>}
  <p class="scene-status" data-scene-status role="status">{experience === 'scale' ? 'Escala inicial: Terra. Selecione um quadro para mudar de escala.' : experience === 'expansion' ? 'Fator de escala 1,00. Observador: galáxia do meio do desenho.' : 'Evidência inicial: expansão. As explicações também estão disponíveis na leitura do capítulo.'}</p>
  <noscript><p class="scene-note">Os textos e imagens renderizadas estão disponíveis. Ative JavaScript para mudar o destaque e iniciar as animações.</p></noscript>
</section>
