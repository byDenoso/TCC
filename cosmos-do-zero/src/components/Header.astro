---
import { u } from '../lib/url';
interface Props { variant?: 'hero' | 'solid'; }
const { variant = 'hero' } = Astro.props;
const nav = [
  { href: '/#observatorio', label: 'Observatório', mobile: 'Observatório: quatro experimentos', spy: 'observatorio' },
  { href: '/#capitulos', label: 'Aulas', mobile: 'As três aulas', spy: 'capitulos' },
  { href: '/laboratorio/', label: 'Mais experimentos', mobile: 'Mais experimentos', spy: 'laboratorio' },
  { href: '/glossario/', label: 'Dicionário', mobile: 'Dicionário do cosmos', spy: 'glossario' }
];
const more = [
  { href: '/laboratorio/#tempo', label: 'Linha do tempo' },
  { href: '/laboratorio/#planetas', label: 'Os oito planetas' },
  { href: '/#desafio', label: 'Desafio' },
  { href: '/fontes/', label: 'Fontes e imagens' }
];
---
<header class:list={['header-shell', variant === 'solid' && 'solid']}>
  <div class="header page-width">
    <a class="identity" href={u('/')} aria-label="Cosmos do Zero, início">
      <span class="identity-mark" aria-hidden="true"></span>
      <span class="identity-name">COSMOS<small>DO ZERO</small></span>
    </a>
    <nav class="main-nav" aria-label="Navegação principal">
      {nav.map((n) => <a href={u(n.href)} data-spy={n.spy} aria-current={(Astro.url.pathname.replace(/\/$/, '').endsWith('/' + n.spy) || (n.spy === 'capitulos' && Astro.url.pathname.includes('/capitulos/')) ? 'page' : undefined)}>{n.label}</a>)}
    </nav>
    <div class="header-tools">
      <button type="button" class="theme-toggle" data-theme-toggle aria-pressed="false" aria-label="Usar tema escuro">
        <svg class="i-moon" viewBox="0 0 24 24" aria-hidden="true"><path d="M20 14.5A8 8 0 0 1 9.5 4a8 8 0 1 0 10.5 10.5Z" /></svg>
        <svg class="i-sun" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="4.2" /><path d="M12 2.5v2.2M12 19.3v2.2M2.5 12h2.2M19.3 12h2.2M5.3 5.3l1.6 1.6M17.1 17.1l1.6 1.6M5.3 18.7l1.6-1.6M17.1 6.9l1.6-1.6" /></svg>
        <span class="theme-label" data-theme-label>Escuro</span>
      </button>
      <a class="header-cta" href={u('/capitulos/galaxias-e-nebulosas/')} data-start-journey><span data-start-label>Começar a aula</span> <span aria-hidden="true">→</span></a>
    </div>
    <details class="mobile-menu" data-mobile-menu>
      <summary aria-label="Abrir ou fechar a navegação">Menu <span aria-hidden="true">+</span></summary>
      <nav aria-label="Navegação móvel">
        {[...nav.map((n) => ({ href: n.href, label: n.mobile })), ...more].map((n, i) => (
          <a href={u(n.href)}><span>{String(i + 1).padStart(2, '0')}</span>{n.label}</a>
        ))}
      </nav>
    </details>
  </div>
  <span class="header-progress" data-header-progress aria-hidden="true"></span>
</header>
