---
// As cinco escalas (Terra → teia cósmica) com os renders do projeto (1200×800, mesmo formato do viewBox 600×400).
// Cada nível marca onde o anterior cabe; o zoom de scenes.ts encolhe/cresce em torno desse ponto.
// Cores em atributos: a cena não depende de CSS para não virar silhueta preta.
import { u } from '../lib/url';
const { hidden = [] } = Astro.props as { hidden?: boolean[] };
const levels = [
  { img: 'earth', at: [300, 200], mark: null, label: 'você está aqui' },
  { img: 'solar-system', at: [181, 194], mark: [181, 194], label: 'Terra' },
  { img: 'milky-way', at: [412, 262], mark: [412, 262], label: 'o Sol está aqui' },
  { img: 'galaxies', at: [160, 109], mark: [160, 109], label: 'Via Láctea', extra: { x: 440, y: 300, t: 'Andrômeda' } },
  { img: 'cosmic-web', at: [154, 175], mark: [154, 175], label: 'nosso Grupo Local' }
] as { img: string; at: number[]; mark: number[] | null; label: string; extra?: { x: number; y: number; t: string } }[];
const halo = 'paint-order:stroke;stroke:#04060b;stroke-width:4px;stroke-linejoin:round';
---
<rect width="600" height="400" fill="#04060b" />
{levels.map((l, i) => (
  <g data-scale-visual={i} data-hidden={hidden[i] ? 'true' : 'false'} style={`transform-box:view-box;transform-origin:${l.at[0]}px ${l.at[1]}px`}>
    <image href={u(`/renders/${l.img}.webp`)} width="600" height="400" preserveAspectRatio="xMidYMid slice" />
    {l.mark ? (
      <g>
        <circle cx={l.mark[0]} cy={l.mark[1]} r="13" fill="none" stroke="#ffd166" stroke-width="3" />
        <line x1={l.mark[0] + 10} y1={l.mark[1] + 9} x2={l.mark[0] + 40} y2={l.mark[1] + 36} stroke="#ffd166" stroke-width="2" />
        <text x={l.mark[0] + 44} y={l.mark[1] + 52} fill="#ffd166" font-size="17" font-weight="700" style={halo}>{l.label}</text>
      </g>
    ) : (
      <text x="20" y="34" fill="#ffd166" font-size="17" font-weight="700" style={halo}>{l.label}</text>
    )}
    {l.extra && <text x={l.extra.x} y={l.extra.y} text-anchor="middle" fill="#f3f1ea" font-size="15" font-weight="600" style={halo}>{l.extra.t}</text>}
  </g>
))}
<text x="590" y="390" text-anchor="end" fill="rgba(243,241,234,.8)" font-size="12" style={halo}>render artístico · fora de escala</text>
