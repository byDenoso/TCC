---
import {u} from '../lib/url';
const {hidden=[]}=Astro.props as {hidden?:boolean[]};
const halo='paint-order:stroke;stroke:#070c18;stroke-width:4px';
---
<rect width="600" height="400" fill="#070c18"/>
<g data-scale-visual="0" data-hidden={hidden[0]?'true':'false'} style="transform-origin:300px 200px;transform-box:view-box">
 <image href={u('/models/portraits/terra.webp')} x="100" y="0" width="400" height="400"/>
 <text x="300" y="365" text-anchor="middle" fill="#f3d29d" font-size="19" style={halo}>Terra · nossa casa</text>
</g>
<g data-scale-visual="1" data-hidden={hidden[1]?'true':'false'} style="transform-origin:270px 200px;transform-box:view-box">
 <circle cx="75" cy="200" r="38" fill="#f1cf94"/><text x="75" y="267" text-anchor="middle" fill="#f3d29d" font-size="18">Sol</text>
 {['mercurio','venus','terra','marte','jupiter','saturno','urano','netuno'].map((name,i)=><g><image href={u(`/models/portraits/${name}.webp`)} x={126+i*54} y={i<4?180:173} width={i<4?36:50} height={i<4?36:50}/>{i===2&&<text x="252" y="261" text-anchor="middle" fill="#f3d29d" font-size="18">Terra</text>}</g>)}
 <text x="300" y="337" text-anchor="middle" fill="#c8d3e2" font-size="17">Tamanhos e separações ilustrativos.</text>
</g>
<g data-scale-visual="2" data-hidden={hidden[2]?'true':'false'} style="transform-origin:370px 230px;transform-box:view-box">
 <image href={u('/models/galaxies-v4/768/barred-spiral.webp')} x="90" y="-10" width="420" height="420"/>
 <circle cx="370" cy="230" r="9" fill="none" stroke="#edc489" stroke-width="2"/><path d="M379 236L437 284" fill="none" stroke="#edc489" stroke-width="2"/><text x="448" y="300" text-anchor="middle" fill="#edc489" font-size="18" style={halo}>o Sol</text>
 <text x="300" y="365" text-anchor="middle" fill="#c8d3e2" font-size="16" style={halo}>Forma e posição angular ilustrativas.</text>
</g>
<g data-scale-visual="3" data-hidden={hidden[3]?'true':'false'} style="transform-origin:180px 200px;transform-box:view-box">
 <image href={u('/models/galaxies-v4/768/barred-spiral.webp')} x="60" y="65" width="245" height="245"/>
 <image href={u('/models/galaxies-v4/768/grand-spiral.webp')} x="325" y="100" width="230" height="230"/>
 <text x="182" y="337" text-anchor="middle" fill="#edc489" font-size="18" style={halo}>Via Láctea</text><text x="439" y="349" text-anchor="middle" fill="#dbe5ef" font-size="18" style={halo}>Andrômeda</text>
</g>
<g data-scale-visual="4" data-hidden={hidden[4]?'true':'false'} style="transform-origin:300px 200px;transform-box:view-box">
 <image href={u('/posters/cosmic-web.webp')} width="600" height="400"/>
 <text x="300" y="372" text-anchor="middle" fill="#edc489" font-size="17" style={halo}>Filamentos e vazios · ilustração</text>
</g>
<text x="590" y="392" text-anchor="end" fill="#b8c5d8" font-size="12" style={halo}>saltos de escala · representação ilustrativa</text>
