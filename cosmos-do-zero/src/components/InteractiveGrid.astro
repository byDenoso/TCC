---
import '../styles/interactive-grid.css';
import { Image } from 'astro:assets';
import { photos, planetArt } from '../lib/images';
import { u, chapterUrl } from '../lib/url';
/**
 * Vitrine dos interativos que já existem no site. Cada cartão diz o que a imagem é
 * (foto real, simulação ou ilustração), para ninguém confundir desenho com observação.
 */
type Card = { href: string; kind: string; title: string; text: string; action: string } & (
  | { photo: keyof typeof photos; focus?: string }
  | { poster: string }
  | { planet: keyof typeof planetArt }
);
const cards: Card[] = [
  { href: `${chapterUrl('galaxias-e-nebulosas')}#exploracao`, kind: 'Simulação 3D', title: 'Do seu quintal à teia cósmica', text: 'Gire a Terra, afaste a câmera e veja onde a Via Láctea fica entre as outras galáxias.', action: 'Abrir o Universo em 3D', poster: 'earth' },
  { href: '#imagens', kind: 'Fotos reais · NASA', title: 'Imagens de telescópio, lidas de perto', text: 'Amplie Andrômeda, os Penhascos Cósmicos e o nascer do Sol visto da Estação Espacial.', action: 'Ler as imagens', photo: 'andromeda-wise', focus: '50% 50%' },
  { href: `${u('/laboratorio/')}#planetas`, kind: 'Ilustração artística', title: 'Oito mundos, nenhum igual', text: 'Escolha um planeta e compare composição, atmosfera e os números que dão forma a cada um.', action: 'Conhecer os planetas', planet: 'saturno' },
  { href: '#viagem', kind: 'Animação guiada', title: '13,8 bilhões de anos em uma rolagem', text: 'Do plasma quente às galáxias de hoje: role a página e o Universo muda na sua frente.', action: 'Fazer a viagem', poster: 'galaxies' },
  { href: '#observatorio', kind: 'Mapa simulado', title: 'A luz mais antiga que existe', text: 'Na máquina do tempo, descubra de que época vem a luz que chega até nós.', action: 'Ligar a máquina do tempo', poster: 'cmb' },
  { href: `${u('/laboratorio/')}#estrelas`, kind: 'Foto real · Webb', title: 'A vida de uma estrela', text: 'Estrelas nascem em nuvens como esta. Escolha a massa inicial e acompanhe o caminho da evolução.', action: 'Seguir uma estrela', photo: 'carina-cosmic-cliffs', focus: '30% 40%' }
];
---
<section class="igrid" id="interativos" aria-labelledby="igrid-title">
  <div class="page-width">
    <header class="igrid-head">
      <div class="section-id">Interativos</div>
      <h2 class="display" id="igrid-title">Escolha uma<br /><em>porta de entrada.</em></h2>
      <p>Seis experiências que funcionam sozinhas. Abra a que der mais curiosidade e mexa à vontade.</p>
    </header>
    <ul class="igrid-cards">
      {cards.map((c) => (
        <li>
          <a class="igrid-card" href={c.href}>
            <span class:list={['igrid-media', 'planet' in c && 'igrid-media--planet', 'poster' in c && 'igrid-media--poster']}>
              {'photo' in c && <Image src={photos[c.photo]} alt="" width={720} height={540} widths={[360, 720]} sizes="(max-width: 700px) 100vw, (max-width: 1100px) 50vw, 400px" fit="cover" position="center" format="webp" quality={78} loading="lazy" style={`object-position:${c.focus ?? '50% 50%'}`} />}
              {'poster' in c && <img src={u(`/posters/${c.poster}-small.webp`)} srcset={`${u(`/posters/${c.poster}-small.webp`)} 600w, ${u(`/posters/${c.poster}.webp`)} 1200w`} sizes="(max-width: 700px) 100vw, (max-width: 1100px) 50vw, 400px" alt="" width="1200" height="800" loading="lazy" decoding="async" />}
              {'planet' in c && <Image src={planetArt[c.planet]} alt="" width={640} widths={[320, 640]} sizes="(max-width: 700px) 80vw, 320px" format="webp" quality={82} loading="lazy" />}
            </span>
            <span class="igrid-body">
              <span class="igrid-kind">{c.kind}</span>
              <strong>{c.title}</strong>
              <span>{c.text}</span>
              <span class="igrid-action">{c.action} <i aria-hidden="true">→</i></span>
            </span>
          </a>
        </li>
      ))}
    </ul>
  </div>
</section>
