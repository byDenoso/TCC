---
import '../styles/interactive-grid.css';
import { Image } from 'astro:assets';
import { courseCovers } from '../lib/course-covers';
import { u } from '../lib/url';
/**
 * Vitrine dos interativos que já existem no site. Cada cartão diz o que a imagem é
 * (foto real, simulação ou ilustração), para ninguém confundir desenho com observação.
 */
type Card = { href: string; cover: keyof typeof courseCovers; title: string; text: string; action: string };
const cards: Card[] = [
  { href: u('/escalas/'), title: 'Do próton ao universo observável', text: 'Arraste a régua ou role para viajar entre partículas, planetas e galáxias.', action: 'Explorar as escalas', cover: 'terra-e-atmosfera' },
  { href: u('/imagens/'), title: 'Fotos do Webb, WISE e da estação espacial', text: 'Amplie Andrômeda, os Penhascos Cósmicos e o nascer do Sol visto da Estação Espacial.', action: 'Ler as imagens', cover: 'galaxias-e-nebulosas' },
  { href: `${u('/laboratorio/')}#planetas`, title: 'Os oito planetas do Sistema Solar', text: 'Compare composição, atmosfera e tamanho dos planetas.', action: 'Conhecer os planetas', cover: 'sistema-solar' },
  { href: u('/#viagem'), title: 'Marcos da história do Universo', text: 'Role a página para avançar da fase de plasma quente até as galáxias de hoje.', action: 'Abrir a linha do tempo', cover: 'misterios-do-cosmos' },
  { href: u('/observatorio/?lab=tempo#observatorio'), title: 'A radiação cósmica de fundo', text: 'Ajuste o redshift e veja quando essa radiação passou a viajar livremente.', action: 'Abrir a máquina do tempo', cover: 'origem-do-universo' },
  { href: `${u('/laboratorio/')}#estrelas`, title: 'A vida de uma estrela', text: 'Estrelas nascem em nuvens como esta. Escolha a massa inicial e acompanhe o caminho da evolução.', action: 'Seguir uma estrela', cover: 'vida-das-estrelas' }
];
---
<section class="igrid" id="interativos" aria-labelledby="igrid-title">
  <div class="page-width">
    <header class="igrid-head">
      <div class="section-id">Interativos</div>
      <h2 class="display" id="igrid-title">Experiências<br /><em>interativas</em></h2>
      <p>Compare escalas em 3D ou examine as imagens com anotações sobre cada objeto.</p>
    </header>
    <ul class="igrid-cards">
      {cards.map((c) => (
        <li>
          <a class="igrid-card" href={c.href}>
            <span class="igrid-media">
              <Image src={courseCovers[c.cover].image} alt={courseCovers[c.cover].alt}
                widths={[240, 480, 800]} sizes="(max-width: 700px) 116px, (max-width: 1100px) 46vw, 400px"
                format="webp" quality={83} loading="lazy" decoding="async"
                style={`object-position:${courseCovers[c.cover].position ?? 'center'}`} />
            </span>
            <span class="igrid-body">
              <span class="igrid-kind">{courseCovers[c.cover].caption}</span>
              <strong>{c.title}</strong>
              <span>{c.text}</span>
              <span class="igrid-action">{c.action} <i aria-hidden="true">→</i></span>
            </span>
          </a>
          <a class="igrid-credit" href={courseCovers[c.cover].source.href}>Imagem · {courseCovers[c.cover].source.credit}</a>
        </li>
      ))}
    </ul>
  </div>
</section>
