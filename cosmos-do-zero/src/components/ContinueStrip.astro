---
import { Image } from 'astro:assets';
import { u } from '../lib/url';
import { photos } from '../lib/images';
const cards = [
  { href: '/laboratorio/', photo: 'iss-sunrise' as const, focus: '50% 60%', kicker: 'Mais experimentos', title: 'Experimentos do laboratório', text: 'Teste órbitas, trânsitos, lentes e modelos de expansão. Depois compare mundos e explore a vida das estrelas.' },
  { href: '/glossario/', photo: 'andromeda-wise' as const, focus: '50% 50%', kicker: 'Dicionário', title: 'Termos das aulas', text: 'Consulte a definição de ano-luz e exemplos de como o redshift é usado nas aulas.' },
  { href: '/fontes/', photo: 'carina-cosmic-cliffs' as const, focus: '70% 40%', kicker: 'Fontes e imagens', title: 'Referências e créditos', text: 'Consulte os estudos citados nas aulas e as legendas originais das imagens.' }
];
---
<section class="continue-strip" id="continue" aria-labelledby="continue-title">
  <div class="page-width">
    <h2 class="visually-hidden" id="continue-title">Laboratório e referências</h2>
    <div class="continue-cards">
      {cards.map((c) => <a class="continue-card" href={u(c.href)}><span class="continue-media"><Image src={photos[c.photo]} alt="" width={720} height={360} widths={[360, 720]} sizes="(max-width: 860px) 100vw, 400px" fit="cover" position="center" format="webp" quality={76} loading="lazy" style={`object-position:${c.focus}`} /></span><span class="meta">{c.kicker}</span><h3>{c.title}</h3><p>{c.text}</p><span class="continue-arrow" aria-hidden="true">→</span></a>)}
    </div>
  </div>
</section>
