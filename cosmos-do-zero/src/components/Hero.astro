---
import { Image } from 'astro:assets';
import webb from '../assets/photos/webb-deep-field.webp';
import Header from './Header.astro';
import { u } from '../lib/url';
import { chapters } from '../data';
import { MICRO } from '../data/micro';
const minutes = chapters.reduce((sum, chapter) => sum + chapter.minutes, 0);
const facts = [
  { value: String(chapters.length), label: 'aulas' },
  { value: String(Object.keys(MICRO).length), label: 'experiências para mexer' },
  { value: `${minutes} min`, label: 'de leitura no total' }
];
---
<div class="hero-root" id="topo">
  <Header />
  <div class="hero-shell">
  <div class="premiere">
  <div class="premiere-visual">
    <Image src={webb} alt="" width={1200} widths={[520, 800, 1200]} sizes="(max-width: 720px) 100vw, 72vw" format="webp" quality={80} loading="eager" fetchpriority="high" />
  </div>
  <section class="premiere-layout page-width" data-home-section="01" aria-labelledby="hero-title">
    <div class="hero-copy">
      <h1 id="hero-title">Cosmologia em seis aulas</h1>
      <p class="hero-introduction">Comece pela Via Láctea. Nas aulas seguintes, veja como a luz de galáxias distantes ajuda a medir a expansão do Universo.</p>
      <div class="hero-actions">
        <a class="cta" href={u('/capitulos/galaxias-e-nebulosas/#galaxias-e-nebulosas-via-lactea')}>Começar a primeira aula <span class="arrow" aria-hidden="true">→</span></a>
        <a class="textlink" href={u('/capitulos/galaxias-e-nebulosas/')} data-start-journey data-home-continue hidden><span data-start-label>Continuar de onde parei</span> <span aria-hidden="true">→</span></a>
        <a class="textlink" href="#movimento">Ver as animações <span aria-hidden="true">↓</span></a>
      </div>
      <ul class="hero-facts" aria-label="O que há no curso">
        {facts.map((fact) => <li><strong>{fact.value}</strong><span>{fact.label}</span></li>)}
      </ul>
    </div>
    <a class="premiere-credit" href="https://esawebb.org/images/weic2209a/" target="_blank" rel="noopener noreferrer">
      <span>Imagem de fundo</span>
      <strong>Primeiro campo profundo do Webb <svg viewBox="0 0 16 16" width="12" height="12" aria-hidden="true"><path d="M3 13 13 3M5 3h8v8" fill="none" stroke="currentColor" stroke-width="1.4" /></svg></strong>
      <small>NIRCam · SMACS 0723 · NASA, ESA, CSA, STScI</small>
    </a>
  </section>
  </div>
</div>
</div>
