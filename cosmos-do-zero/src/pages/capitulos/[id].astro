---
import { Image } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import Header from '../../components/Header.astro';
import HubbleLesson from '../../components/HubbleLesson.astro';
import LessonPath from '../../components/LessonPath.astro';
import QuizCard from '../../components/QuizCard.astro';
import CosmosScene from '../../components/CosmosScene.astro';
import Observatorio from '../../components/Observatorio.astro';
import Micro from '../../components/Micro.astro';
import Lensing from '../../components/Lensing.astro';
import ExpansionExhibit from '../../components/ExpansionExhibit.astro';
import TransitExhibit from '../../components/TransitExhibit.astro';
import HRExhibit from '../../components/HRExhibit.astro';
import BlackHoleExhibit from '../../components/BlackHoleExhibit.astro';
import OrbitExhibit from '../../components/OrbitExhibit.astro';
import SolarStudio from '../../components/SolarStudio.astro';
import CmbJourney from '../../components/CmbJourney.astro';
import StoryLesson from '../../components/StoryLesson.astro';
import { STORIES } from '../../lib/story-scenes';
import { MICRO } from '../../data/micro';
import { LESSON_GUIDES } from '../../data/lesson-guides';
import { adjacentChapters, chapterOrder, chapterPhotoKey, chapters, chapterTitleShort, chapterTrack, imageCredits, terms } from '../../data';
import { linkTerms } from '../../lib/terms';
import { photos } from '../../lib/images';
import { chapterUrl, u } from '../../lib/url';
import type { ChapterId } from '../../types';
import { pad2 } from '../../lib/format';
import '../../styles/reader.css';
import '../../styles/micro.css';
import '../../styles/cmb-journey.css';
import '../../styles/ux-refinements.css';

export function getStaticPaths() {
  return chapterOrder.map((id) => ({ params: { id }, props: { id } }));
}
const { id } = Astro.props;
const ch = chapters.find((c) => c.id === id)!;
const n = chapterOrder.indexOf(ch.id)+1;
const isPrimary = chapterTrack(ch.id) === 'primary';
const { prev, next } = adjacentChapters(ch.id);
const photoKey = chapterPhotoKey[ch.id];
const credit = photoKey ? imageCredits[['andromeda-wise', 'carina-cosmic-cliffs', 'iss-sunrise'].indexOf(photoKey)] : undefined;
const [checkA, checkB] = ch.checkTitle.split('|');
const ext = ' (abre em outra aba)';
const usedTerms = new Set<string>();
const bodies = ch.sections.map((s) => linkTerms(s.body, terms, usedTerms));
const openingPoster: Record<ChapterId, string> = {
  'galaxias-e-nebulosas': 'galaxies',
  'origem-do-universo': 'cmb',
  'misterios-do-cosmos': 'cosmic-web',
  'vida-das-estrelas': 'star',
  'sistema-solar': 'solar-system',
  'terra-e-atmosfera': 'earth'
};
const poster = openingPoster[ch.id];
const labStations = ({ 'galaxias-e-nebulosas': ['tempo'], 'origem-do-universo': ['expansao', 'receita'], 'misterios-do-cosmos': ['hubble', 'receita'] } as Record<string, ('tempo' | 'expansao' | 'hubble' | 'receita')[]>)[ch.id];
---
<Base title={`${ch.title} · Cosmos do Zero`} description={ch.intro} bodyClass="reader-page" learningResource>
  <div id="topo"><Header variant="solid" /></div>
  <main id="principal">
    <article class="chapter-reader" data-reader={ch.id}>
      <div class="reader-opening page-width">
        {poster && <div class="reader-plate" aria-hidden="true"><img src={u(`/posters/${poster}-small.webp`)} width="600" height="400" alt="" fetchpriority="low" decoding="async" /></div>}
        <div class="reader-welcome">
        <a class="back-link" href={u('/#capitulos')}>← Todas as aulas</a>
        <div class="exhibit-label"><span>{pad2(n)}</span> {ch.minutes} min · {ch.sections.length} passos</div>
        <h1>{ch.title}</h1>
        <p class="reader-intro">{STORIES[ch.id].lede}</p>
        <nav class="reader-entry" aria-label="Por onde começar esta aula">
          <a class="cta" href={`#${ch.sections[0].id}`}>Começar a aula <span aria-hidden="true">↓</span></a>
          {labStations && <a class="textlink" href={`#${ch.experience === 'expansion' ? 'exploracao' : 'observatorio'}`}>Instrumentos extras <span aria-hidden="true">↓</span></a>}
        </nav>
        <details class="reader-overview"><summary>O que você vai descobrir</summary><div class="reader-idea"><p>{ch.intro}</p>{ch.learningGoal && <p class="reader-goal"><strong>Ao final, você consegue:</strong> {ch.learningGoal}</p>}<p>{ch.idea}</p></div></details>
        </div>
        <StoryLesson id={ch.id}/>
        <div class="reader-path-row"><LessonPath id={ch.id}/></div>
      </div>
      <div class="reader-grid page-width" id="leitura">
        <aside class="reader-aside">
          <div class="meta">Neste capítulo</div>
          <nav aria-label="Seções do capítulo" data-toc>
            {ch.sections.map((s, i) => <a href={`#${s.id}`}><span>{pad2(i + 1)}</span>{s.title}</a>)}
          </nav>
          <button class="reader-summary" type="button" data-story-open hidden>Rever resumo animado <span>20 segundos · cena ou vídeo</span></button>
          <div class="depth-controls" role="group" aria-label="Nível de aprofundamento">
            <button type="button" data-depth="essential" aria-pressed="true">Explorar</button>
            <button type="button" data-depth="more" aria-pressed="false">Compreender</button>
            <button type="button" data-depth="deep" aria-pressed="false">Aprofundar</button>
          </div>
          <a href={u('/glossario/')} class="glossary-link">Abrir o dicionário ↗</a>
        </aside>
        <div class="reader-content">
          {ch.sections.map((s, i) => (
            <section class="lesson-section" id={s.id}>
              <div class="lesson-meta">
                <span class="meta">{pad2(i + 1)} / {pad2(ch.sections.length)}</span>
                <span class="evidence-label" data-kind={s.evidence} title={s.evidence}>{({ 'Observação': 'Sabemos · observado', 'Modelo físico': 'Calculamos · modelo', 'Questão aberta': 'Ainda não sabemos' } as Record<string, string>)[s.evidence] ?? s.evidence}</span>
              </div>
              <h2>{s.title}</h2>
              <div class="lesson-observe"><span aria-hidden="true">◎</span><p><strong>O que observar. </strong>{LESSON_GUIDES[s.id].observe}</p></div>
              {s.id === 'origem-do-universo-primeira-luz' && MICRO[s.id] ? <CmbJourney spec={MICRO[s.id]} id={s.id} /> : MICRO[s.id] && <Micro spec={MICRO[s.id]} id={s.id} chapter={ch.id} />}
              {s.id === 'misterios-do-cosmos-materia-escura' && <Lensing id={s.id} />}
              {s.id === 'sistema-solar-sol-e-planetas' && <><SolarStudio id={s.id} /><OrbitExhibit heading="h3" /></>}
              {s.id === 'origem-do-universo-expansao' && <><HubbleLesson/><ExpansionExhibit heading="h3" /></>}
              {s.id === 'misterios-do-cosmos-exoplanetas' && <TransitExhibit heading="h3" />}
              {s.id === 'vida-das-estrelas-fusao' && <HRExhibit heading="h3" />}
              {s.id === 'galaxias-e-nebulosas-centros-galacticos' && <BlackHoleExhibit heading="h3" />}
              <aside class="lesson-connection"><span>A ideia por trás da cena</span><p>{LESSON_GUIDES[s.id].connect}</p></aside>
              <p class="lesson-try"><strong>Agora experimente. </strong>{LESSON_GUIDES[s.id].try}</p>
              <p>{bodies[i].map((seg, k) => 'term' in seg ? (
                <><button type="button" class="term" popovertarget={`termo-${i}-${k}`}>{seg.text}</button><span popover id={`termo-${i}-${k}`} class="term-pop" role="note"><strong>{seg.term.term}</strong> {seg.term.definition} <em>Exemplo: {seg.term.example}</em><a href={u(`/glossario/?q=${encodeURIComponent(seg.term.term)}#termo-${seg.index}`)}>Ver no dicionário →</a></span></>
              ) : seg.text)}</p>

              {s.more && (
                <details class="depth-detail" data-layer="more">
                  <summary>Entenda melhor</summary>
                  <p>{s.more}</p>
                  {s.equation?.layer === 'more' && <figure class="equation"><div>{s.equation.formula}</div><figcaption>{s.equation.caption}</figcaption></figure>}
                </details>
              )}
              {s.deep && (
                <details class="depth-detail" data-layer="deep">
                  <summary>Aprofundamento</summary>
                  <p>{s.deep}</p>
                  {s.equation?.layer === 'deep' && <figure class="equation"><div>{s.equation.formula}</div><figcaption>{s.equation.caption}</figcaption></figure>}
                </details>
              )}
            </section>
          ))}
          <section class="chapter-check" aria-labelledby="check-title">
            <div class="section-id">Pare um instante. O que ficou?</div>
            <h2 id="check-title">{checkA}<br /><em>{checkB}</em></h2>
            <QuizCard chapter={ch.id} />
          </section>
          <section class="reader-references" aria-labelledby={`refs-${ch.id}`}>
            <h2 id={`refs-${ch.id}`}>{ch.refHeading}</h2>
            <p>{ch.refNote}</p>
            <ul>{ch.refs.map((r) => <li><a href={r.href} target="_blank" rel="noopener noreferrer">{r.title} <span aria-hidden="true">↗</span><span class="visually-hidden">{ext}</span></a></li>)}</ul>
          </section>
        </div>
      </div>
      <details class="school-extra page-width" open><summary><span><strong>Continue investigando</strong><small>Imagens, instrumentos e explorações desta aula</small></span><span aria-hidden="true">+</span></summary><div class="school-extra-content">
      {photoKey && credit ? (
        <figure class="chapter-photo">
          <Image src={photos[photoKey]} alt={credit.alt} widths={[640, 1000, 1600]} sizes="100vw" width={1600} height={480} fit="cover" position="center" format="webp" quality={80} loading="lazy" />
          <figcaption class="page-width">
            <strong>{credit.title}</strong> · <span>{credit.kind}</span> · {credit.credit}.
            <a href={credit.href} target="_blank" rel="noopener noreferrer">Imagem e legenda originais <span aria-hidden="true">↗</span><span class="visually-hidden">{ext}</span></a>
          </figcaption>
        </figure>
      ) : null}
      {labStations && <Observatorio variant="chapter" stations={labStations} id={ch.experience === 'expansion' ? 'exploracao' : 'observatorio'} />}
      {ch.experience && ch.experience !== 'expansion' && <CosmosScene experience={ch.experience} />}
      </div></details>
      <div class="reader-finish page-width">
        <button class="cta" type="button" data-complete={ch.id} aria-pressed="false"><span data-complete-label>Concluir este capítulo</span> <span class="arrow" aria-hidden="true">✓</span></button>
        <p data-complete-status role="status">Seu progresso fica neste navegador.</p>
      </div>
      <nav class="chapter-pagination page-width" aria-label="Continuar a jornada">
        {prev ? <a class="textlink" href={chapterUrl(prev.id)}>← Anterior: {chapterTitleShort[prev.id]}</a> : <a class="textlink" href={u('/#capitulos')}>← Início da trilha</a>}
        <a class="next-lesson-card" href={next ? chapterUrl(next.id) : u(isPrimary ? '/desafio/#desafio' : '/laboratorio/')}>
          <span class="next-lesson-copy">
            <span class="meta">{next ? `A seguir · ${next.minutes} min` : isPrimary ? 'Sua próxima descoberta' : 'Continue explorando'}</span>
            <strong>{next ? chapterTitleShort[next.id] : isPrimary ? 'Conecte as três ideias' : 'Volte ao laboratório'}</strong>
            <span>{next ? (next.learningGoal ?? next.intro) : isPrimary ? 'Revisite o que aprendeu no desafio da jornada. As explicações ajudam a escolher o que explorar de novo.' : 'Escolha outro experimento e continue investigando as suas perguntas.'}</span>
          </span>
          <span class="next-lesson-arrow" aria-hidden="true">→</span>
        </a>
      </nav>
    </article>
  </main>
</Base>

