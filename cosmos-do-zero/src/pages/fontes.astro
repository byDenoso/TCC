---
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import PhotoBand from '../components/PhotoBand.astro';
import Sources from '../components/Sources.astro';
import '../styles/home.css';
import '../styles/ux-refinements.css';
---
<Base title="Fontes e imagens · Cosmos do Zero" bodyClass="sources-page" description="De onde vêm as explicações e as imagens do Cosmos do Zero: referências científicas, créditos e como separamos o que sabemos, o que calculamos e o que ainda não sabemos.">
  <div id="topo"><Header variant="solid" /></div>
  <PhotoBand photo="carina-cosmic-cliffs" focus="30% 45%" />
  <main id="principal" class="subpage"><Sources headingLevel="h1" /></main>
</Base>
