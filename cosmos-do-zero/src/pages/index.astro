---
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import Observatorio from '../components/Observatorio.astro';
import ChapterList from '../components/ChapterList.astro';
import QuizSection from '../components/QuizSection.astro';
import ContinueStrip from '../components/ContinueStrip.astro';
import '../styles/home.css';
---
<Base title="Cosmos do Zero · Seu primeiro passo no Universo" description="Cosmologia para curiosos, do zero: volte no tempo até a luz mais antiga, deixe o espaço se expandir, meça a velocidade da expansão e descubra do que o Universo é feito em quatro experimentos interativos.">
  <Hero />
  <main id="principal">
    <Observatorio />
    <ChapterList />
    <QuizSection />
    <ContinueStrip />
    <noscript><p class="noscript-note page-width">A leitura, as tabelas, o glossário e as fontes estão disponíveis sem JavaScript. Para usar os instrumentos do observatório, mudar as experiências e responder aos quizzes, ative JavaScript.</p></noscript>
  </main>
</Base>
