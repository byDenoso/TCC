---
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import MotionLab from '../components/MotionLab.astro';
import CosmicJourney from '../components/CosmicJourney.astro';
import ChapterList from '../components/ChapterList.astro';
import { MICRO } from '../data/micro';
import '../styles/home.css';
import '../styles/ux-refinements.css';
---
<Base title="Cosmos do Zero · Escola interativa de cosmologia" description={`Seis aulas de cosmologia com ${Object.keys(MICRO).length} experiências. A trilha principal vai da Via Láctea às medidas da expansão do Universo.`} bodyClass="school-home" websiteSchema>
  <Hero />
  <main id="principal">
    <MotionLab />
    <ChapterList />
    <CosmicJourney />
    <noscript><p class="noscript-note page-width">A leitura, as tabelas, o glossário e as fontes estão disponíveis sem JavaScript. Para usar os instrumentos do observatório, mudar as experiências e responder aos quizzes, ative JavaScript.</p></noscript>
  </main>
</Base>
