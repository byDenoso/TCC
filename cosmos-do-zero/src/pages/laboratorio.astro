---
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import PhotoBand from '../components/PhotoBand.astro';
import Timeline from '../components/Timeline.astro';
import PlanetCatalog from '../components/PlanetCatalog.astro';
import ExpansionExhibit from '../components/ExpansionExhibit.astro';
import TransitExhibit from '../components/TransitExhibit.astro';
import HRExhibit from '../components/HRExhibit.astro';
import OrbitExhibit from '../components/OrbitExhibit.astro';
import Lensing from '../components/Lensing.astro';
import Lab from '../components/Lab.astro';
import { extraRows } from '../data';
import { chapterUrl, u } from '../lib/url';
import '../styles/home.css';
import '../styles/ux-refinements.css';
const stations = [
  { href: '#orbitas', topic: 'Gravidade', title: 'Órbitas de Kepler', question: 'Como posição, massa e velocidade mudam uma órbita?' },
  { href: '#expansao-modelos', topic: 'Cosmologia', title: 'História da expansão', question: 'O que muda em H(z), tempo e distância quando ajustamos o modelo?' },
  { href: '#transito', topic: 'Exoplanetas', title: 'Trânsito de exoplanetas', question: 'Qual geometria produz uma queda de brilho?' },
  { href: '#diagrama-hr', topic: 'Estrelas', title: 'Diagrama Hertzsprung–Russell', question: 'Como temperatura e raio alteram a luminosidade?' },
  { href: '#lente-gravitacional', topic: 'Gravidade', title: 'Lentes gravitacionais', question: 'Em que alinhamento aparece um anel?' },
  { href: u('/luz/#luz-cena-3'), topic: 'Espectroscopia', title: 'Explorador de redshift', question: 'Quanto as linhas se deslocam com a expansão?' },
  { href: `${chapterUrl('galaxias-e-nebulosas')}#galaxias-e-nebulosas-teia-cosmica`, topic: 'Estrutura cósmica', title: 'Filamentos, halos e vazios', question: 'Em que escalas aparecem agrupamentos, filamentos e vazios?' }
];
---
<Base title="Mais experimentos · Cosmos do Zero" bodyClass="lab-page" description="Linha do tempo do Universo, os oito planetas lado a lado e a vida das estrelas: experimentos para continuar explorando depois das aulas.">
  <div id="topo"><Header variant="solid" /></div>
  <PhotoBand photo="iss-sunrise" focus="50% 55%" />
  <main id="principal" class="subpage">
    <header class="subpage-head page-width">
      <p class="exhibit-label"><span>02</span> Laboratório · Bancadas de investigação</p>
      <h1 class="display">Mude uma condição.<br /><em>Veja o que acontece.</em></h1>
      <p>Mude a forma de uma órbita, compare planetas ou volte a uma época do Universo. Cada bancada isola uma pergunta.</p>
      <nav class="subpage-jump" aria-label="Nesta página">
        <a href="#bancadas">Bancadas</a><a href="#tempo">Linha do tempo</a><a href="#planetas">Os oito planetas</a><a href="#laboratorio">Comparar mundos e estrelas</a><a href="#leituras">Leituras extras</a>
      </nav>
    </header>
    <section class="page-width lab-index" id="bancadas" aria-labelledby="lab-index-title">
      <p class="exhibit-label"><span>07</span> Instrumentos de investigação</p>
      <h2 id="lab-index-title">Escolha uma bancada.</h2>
      <ol>{stations.map((station, i) => <li><a href={station.href}><span class="lab-index-number">0{i + 1}</span><span><small>{station.topic}</small><strong>{station.title}</strong><span>{station.question}</span></span><span aria-hidden="true">→</span></a></li>)}</ol>
    </section>
    <div class="page-width lab-feature"><OrbitExhibit /><ExpansionExhibit /><TransitExhibit /><HRExhibit /></div>
    <div class="page-width lab-feature" id="lente-gravitacional"><Lensing id="laboratorio-lente" /></div>
    <Timeline />
    <PlanetCatalog />
    <Lab />
    <section class="extra-section" id="leituras" aria-labelledby="extras-title">
      <div class="page-width extra-intro"><h2 id="extras-title">Estrelas, planetas e a nossa casa</h2></div>
      <div class="extra-reading-links page-width">{extraRows.map((r) => <a href={chapterUrl(r.id)}><span class="meta">Leitura complementar</span><h3>{r.title}</h3><p>{r.teaser}</p><span class="textlink">Abrir capítulo ↗</span></a>)}</div>
    </section>
  </main>
</Base>
