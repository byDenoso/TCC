---
import '../styles/fonts.css';
import '../styles/global.css';
import '../styles/quiz.css';
import '../styles/volume.css';
import '../styles/motion.css';
import '../styles/editorial.css';
import '../styles/reading-refinements.css';
import '../styles/cosmic-theme.css';
import '../styles/experience-design.css';
import '../styles/dynamic-experience.css';
import '../styles/school.css';
import '../styles/cinema.css';
import '../styles/immersive.css';
import '../styles/museum.css';
import '../styles/planetarium.css';
import '../styles/direction.css';
import Footer from '../components/Footer.astro';
import { u } from '../lib/url';

interface Props {
  title: string;
  description: string;
  bodyClass?: string;
  noindex?: boolean;
  websiteSchema?: boolean;
  learningResource?: boolean;
}
const { title, description, bodyClass = '', noindex = false, websiteSchema = false, learningResource = false } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
const shareImage = new URL(u('/social-card.png'), Astro.site);
const schema = websiteSchema || learningResource ? {
  '@context': 'https://schema.org',
  '@type': websiteSchema ? 'WebSite' : 'LearningResource',
  name: websiteSchema ? 'Cosmos do Zero' : title,
  description,
  url: canonical.href,
  inLanguage: 'pt-BR',
  ...(learningResource ? {
    learningResourceType: 'Aula interativa',
    isPartOf: { '@type': 'WebSite', name: 'Cosmos do Zero', url: new URL(u('/'), Astro.site).href }
  } : {})
} : null;
const indexingAllowed = import.meta.env.PUBLIC_SITE_INDEXING === 'true';
---
<!doctype html>
<html lang="pt-BR" data-theme="light">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#f1e9d6" />
    <script is:inline>(function () { var t = null; try { t = localStorage.getItem('cosmos-theme'); } catch (e) {} if (t !== 'light' && t !== 'dark') t = 'light'; document.documentElement.dataset.theme = t; })();</script>
    <script is:inline>(function(){var m='full';try{m=localStorage.getItem('cosmos-motion')||m;}catch(e){}document.documentElement.dataset.motion=matchMedia('(prefers-reduced-motion: reduce)').matches?'reduced':m;})();</script>
    <meta name="description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="pt_BR" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical.href} />
    <meta property="og:site_name" content="Cosmos do Zero" />
    <meta property="og:image" content={shareImage.href} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Cartão do Cosmos do Zero com uma ilustração da Terra cercada por órbitas." />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="canonical" href={canonical.href} />
    {(noindex || !indexingAllowed) && <meta name="robots" content="noindex, nofollow" />}
    <link rel="icon" href={u('/favicon.svg')} type="image/svg+xml" />
    <title>{title}</title>
    {schema && <script is:inline type="application/ld+json" set:html={JSON.stringify(schema).replace(/</g, '\\u003c')} />}
  </head>
  <body class={bodyClass}>
    <a class="skip" href="#principal">Ir para o conteúdo</a>
    <slot />
    <Footer />
    <script>
      import '../scripts/main';
    </script>
  </body>
</html>

