---
import '../styles/fonts.css';
import '../styles/global.css';
import '../styles/volume.css';
import '../styles/motion.css';
import '../styles/editorial.css';
import '../styles/reading-refinements.css';
import Footer from '../components/Footer.astro';
import { u } from '../lib/url';

interface Props {
  title: string;
  description: string;
  bodyClass?: string;
  noindex?: boolean;
}
const { title, description, bodyClass = '', noindex = false } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
const shareImage = new URL(u('/social-card.png'), Astro.site);
const indexingAllowed = import.meta.env.PUBLIC_SITE_INDEXING === 'true';
---
<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#fff8e7" />
    <script is:inline>(function () { var t = null; try { t = localStorage.getItem('cosmos-theme'); } catch (e) {} if (t !== 'light' && t !== 'dark') t = window.matchMedia && matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light'; document.documentElement.dataset.theme = t; })();</script>
    <meta name="description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="pt_BR" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical.href} />
    <meta property="og:site_name" content="Cosmos do Zero" />
    <meta property="og:image" content={shareImage.href} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Cosmos do Zero: uma viagem interativa para entender o Universo." />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="canonical" href={canonical.href} />
    {(noindex || !indexingAllowed) && <meta name="robots" content="noindex, nofollow" />}
    <link rel="icon" href={u('/favicon.svg')} type="image/svg+xml" />
    <title>{title}</title>
  </head>
  <body class={bodyClass}>
    <a class="skip" href="#principal">Ir para o conteúdo</a>
    <slot />
    <Footer />
    <script>
      import '../scripts/main';
    </script>
  </body>
</html>
