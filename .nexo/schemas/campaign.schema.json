{
  "title": "NEXO Campaign",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "campaign_id", "domain", "question", "status", "budget", "tests"],
  "properties": {
    "schema_version": {"const": 1},
    "campaign_id": {"type": "string", "minLength": 3},
    "domain": {"type": "string", "minLength": 2},
    "question": {"type": "string", "minLength": 3},
    "status": {"type": "string"},
    "budget": {
      "type": "object",
      "additionalProperties": false,
      "required": ["max_tests", "max_parallel", "max_retries_per_test", "max_runtime_minutes"],
      "properties": {
        "max_tests": {"type": "integer", "minimum": 1},
        "max_parallel": {"type": "integer", "minimum": 1},
        "max_retries_per_test": {"type": "integer", "minimum": 0},
        "max_runtime_minutes": {"type": "integer", "minimum": 1}
      }
    },
    "tests": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["test_id", "executor", "workflow", "ref", "inputs", "depends_on", "promotion"],
        "properties": {
          "test_id": {"type": "string", "minLength": 3},
          "executor": {"type": "string"},
          "workflow": {"type": "string"},
          "ref": {"type": "string"},
          "inputs": {"type": "object"},
          "depends_on": {"type": "array", "items": {"type": "string"}},
          "promotion": {
            "type": "object",
            "additionalProperties": false,
            "required": ["require_workflow_success", "require_artifact", "validator"],
            "properties": {
              "require_workflow_success": {"type": "boolean"},
              "require_artifact": {"type": "boolean"},
              "validator": {"type": "string"}
            }
          }
        }
      }
    }
  }
}
